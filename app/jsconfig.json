{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "baseUrl": "..",
    "paths": {
      "@engine": [
        "src/engine.js"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/globals.d.ts",
    "../src/engine.js"
  ],
  "exclude": [
    "**/node_modules"
  ]
}