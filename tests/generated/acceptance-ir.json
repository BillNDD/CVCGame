              "kind": "Given",
              "text": "a player on Level 5 with 39 of the 50 words at box 3"
            },
            {
              "kind": "When",
              "text": "the session ends"
            },
            {
              "kind": "Then",
              "text": "the player stays on Level 5"
            }
          ],
          "examples": []
        },
        {
          "name": "Box 2 words are not solid",
