    {
      "file": "features/session.feature",
      "name": "Building a session",
      "scenarios": [
        {
          "name": "The first session serves the whole starter level",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a brand-new player"
            },
            {
              "kind": "When",
              "text": "a session is built"
            },
            {
              "kind": "Then",
              "text": "it has exactly 12 words"
            },
            {
              "kind": "Then",
              "text": "every word is a Level 1 word"
            },
            {
              "kind": "Then",
              "text": "no word repeats"
            }
          ],
          "examples": []
        },
        {
          "name": "A full level fills the target",
