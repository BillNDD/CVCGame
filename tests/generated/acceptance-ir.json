{
  "features": [
    {
      "file": "features/export.feature",
      "name": "The reading log export",
      "scenarios": [
        {
          "name": "Box 3 does not count as mastered",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a fresh player whose words \"cat\" and \"dog\" sit in box 3"
            },
            {
              "kind": "When",
              "text": "the log is exported"
            },
            {
              "kind": "Then",
              "text": "the export contains \"0/439\""
            }
          ],
          "examples": []
        },
        {
          "name": "Box 4 counts as mastered",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a fresh player whose words \"cat\" and \"dog\" sit in box 4"
            },
            {
              "kind": "When",
              "text": "the log is exported"
            },
            {
              "kind": "Then",
              "text": "the export contains \"2/439\""
            }
          ],
          "examples": []
        },
        {
          "name": "A short session is marked",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a fresh player with one logged session marked as partial"
            },
            {
              "kind": "When",
              "text": "the log is exported"
            },
            {
              "kind": "Then",
              "text": "the export contains \"partial\""
            }
          ],
          "examples": []
        },
        {
          "name": "A name with an emoji at the limit stays whole",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "the reader's name is 19 letters followed by the chick emoji"
            },
            {
              "kind": "When",
              "text": "the log is exported"
            },
            {
              "kind": "Then",
              "text": "the export contains the chick emoji"
            },
            {
              "kind": "Then",
              "text": "the export contains no broken character"
            }
          ],
          "examples": []
        }
      ]
    },
    {
      "file": "features/grading.feature",
      "name": "Grading a reading attempt",
      "scenarios": [
        {
          "name": "A new word read correctly at first sight moves fast",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a word the child has never attempted"
            },
            {
              "kind": "When",
              "text": "the child reads it correctly in session 1"
            },
            {
              "kind": "Then",
              "text": "the word is in box 3"
            },
            {
              "kind": "Then",
              "text": "the word is due again in session 5"
            }
          ],
          "examples": []
        },
        {
          "name": "A known word read correctly moves up one box",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a word in box 1 with 2 attempts"
            },
            {
              "kind": "When",
              "text": "the child reads it correctly in session 10"
            },
            {
              "kind": "Then",
              "text": "the word is in box 2"
            },
            {
              "kind": "Then",
              "text": "the word is due again in session 12"
            }
          ],
          "examples": []
        },
        {
          "name": "A word at the top box stays at the top",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a word in box 5 with 9 attempts"
            },
            {
              "kind": "When",
              "text": "the child reads it correctly in session 10"
            },
            {
              "kind": "Then",
              "text": "the word is in box 5"
            },
            {
              "kind": "Then",
              "text": "the word is due again in session 22"
            }
          ],
          "examples": []
        },
        {
          "name": "A close attempt lifts a word out of the bottom box",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a word in box 0 with 1 attempts"
            },
            {
              "kind": "When",
              "text": "the child is close in session 5"
            },
            {
              "kind": "Then",
              "text": "the word is in box 1"
            },
            {
              "kind": "Then",
              "text": "the word is due again in session 6"
            }
          ],
          "examples": []
        },
        {
          "name": "A close attempt never demotes a strong word",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a word in box 4 with 4 attempts"
            },
            {
              "kind": "When",
              "text": "the child is close in session 5"
            },
            {
              "kind": "Then",
              "text": "the word is in box 4"
            }
          ],
          "examples": []
        },
        {
          "name": "A miss drops the word two boxes",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a word in box 4 with 3 attempts"
            },
            {
              "kind": "When",
              "text": "the child misses it in session 7"
            },
            {
              "kind": "Then",
              "text": "the word is in box 2"
            },
            {
              "kind": "Then",
              "text": "the word is due again in session 9"
            }
          ],
          "examples": []
        },
        {
          "name": "A miss never drops below the bottom box",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
              "text": "a word in box 1 with 3 attempts"
            },
            {
              "kind": "When",
              "text": "the child misses it in session 7"
            },
            {
              "kind": "Then",
              "text": "the word is in box 0"
            },
            {
              "kind": "Then",
              "text": "the word is due again in session 8"
            }
          ],
          "examples": []
        },
        {
          "name": "The review ladder by box",
          "outline": true,
          "steps": [
            {
              "kind": "Given",
              "text": "a word in box <box> with 2 attempts"
            },
            {
              "kind": "When",
              "text": "the child is close in session 100"
            },
            {
              "kind": "Then",
              "text": "the word is due again in session <due>"
            }
          ],
          "examples": [
            {
              "box": "0",
              "due": "101"
            },
            {
              "box": "1",
              "due": "101"
            },
            {
              "box": "2",
              "due": "102"
            },
            {
              "box": "3",
              "due": "104"
            },
            {
              "box": "4",
              "due": "107"
            },
            {
              "box": "5",
              "due": "112"
            }
          ]
        }
      ]
    },
    {
      "file": "features/phonics.feature",
      "name": "Sound units and feedback text",
      "scenarios": [
        {
          "name": "A word splits into sound units",
          "outline": true,
          "steps": [
            {
              "kind": "When",
              "text": "the app shows the sound tiles for \"<word>\""
            },
            {
              "kind": "Then",
              "text": "the tiles read \"<tiles>\""
            },
            {
              "kind": "Then",
              "text": "the dashed form is \"<dashed>\""
            }
          ],
          "examples": [
            {
              "word": "cat",
              "tiles": "c,a,t",
              "dashed": "c-a-t"
            },
            {
              "word": "ship",
              "tiles": "sh,i,p",
              "dashed": "sh-i-p"
            },
            {
              "word": "duck",
              "tiles": "d,u,ck",
              "dashed": "d-u-ck"
            },
            {
              "word": "sing",
              "tiles": "s,i,ng",
              "dashed": "s-i-ng"
            },
            {
              "word": "when",
              "tiles": "wh,e,n",
              "dashed": "wh-e-n"
            },
            {
              "word": "this",
              "tiles": "th,i,s",
              "dashed": "th-i-s"
            },
            {
              "word": "ax",
              "tiles": "a,x",
              "dashed": "a-x"
            }
          ]
        },
        {
          "name": "Feedback for a correct reading",
          "outline": false,
          "steps": [
            {
              "kind": "When",
              "text": "the app gives feedback for a \"correct\" reading of \"cat\""
            },
            {
              "kind": "Then",
              "text": "the feedback lead is \"Great job! That is \""
            },
            {
              "kind": "Then",
              "text": "the feedback shows \"c-a-t\" and the word \"cat\""
            }
          ],
          "examples": []
        },
        {
          "name": "Feedback for a close reading",
          "outline": false,
          "steps": [
            {
              "kind": "When",
              "text": "the app gives feedback for a \"close\" reading of \"ship\""
            },
            {
              "kind": "Then",
              "text": "the feedback lead is \"Good try! The correct pronunciation is \""
            },
            {
              "kind": "Then",
              "text": "the feedback shows \"sh-i-p\" and the word \"ship\""
            }
          ],
          "examples": []
        },
        {
          "name": "Feedback for a missed reading",
          "outline": false,
          "steps": [
            {
              "kind": "When",
              "text": "the app gives feedback for a \"wrong\" reading of \"sun\""
            },
            {
              "kind": "Then",
              "text": "the feedback lead is \"Let’s try that again. The correct pronunciation is \""
            },
            {
              "kind": "Then",
              "text": "the feedback shows \"s-u-n\" and the word \"sun\""
            }
          ],
          "examples": []
        },
        {
          "name": "The tricky word \"was\" carries its note",
          "outline": false,
          "steps": [
            {
              "kind": "Then",
              "text": "the word \"was\" carries the note \"Tricky word! The a sounds like “uh” — wuz.\""
            }
          ],
          "examples": []
        },
        {
          "name": "The tricky word \"is\" carries its note",
          "outline": false,
          "steps": [
            {
              "kind": "Then",
              "text": "the word \"is\" carries the note \"Tricky word! The s sounds like “z” — iz.\""
            }
          ],
          "examples": []
        }
      ]
    },
    {
      "file": "features/promotion.feature",
      "name": "Level promotion",
      "scenarios": [
        {
          "name": "Exactly 80 percent promotes",
          "outline": false,
          "steps": [
            {
              "kind": "Given",
