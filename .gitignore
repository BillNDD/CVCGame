# ============================================================
# Word Quest .gitignore
# Rule 1: commit only the game and its documents.
# Rule 2: do not commit personal data.
# Note: do not write a child's name in this file. The file is public.
# ============================================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.*

# ---- Generated code ----
src/engine.js
reference/.mutant.jsx

# ---- Build output ----
dist/
build/
out/
.vite/
.cache/
coverage/
*.tsbuildinfo

# ---- Secrets and environment files ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Logs and debug files ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Operating system files ----
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ---- Editor files ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Test output ----
test-results/
playwright-report/
# the census writes its report, traces and screenshots here; findings are
# read from it and acted on, never committed
.census/

# ---- Personal data: never commit these ----
# The app can export a reading log. Keep all exports out of the repository.
*reading-log*
*progress*.json
*.export.json
*.export.md
# Keep personal copies, notes, and local builds out of the repository.
personal/
private/
notes/
*personal*
*-local.*
*.local.*

# ---- Gauntlet run lock ----
.gauntlet.lock/

# Voice renderer inputs, fetched on demand (docs/voice-pack.md). Hundreds of MB;
# never committed. The pack itself is committed, the model that renders it is not.
kokoro-v1.0.onnx
voices-v1.0.bin
kokoro-env/
# the clip list the renderer reads, regenerated from the engine each time
script.json
tools/__pycache__/
.gauntlet-evidence.json
.cov-control/
.claude/launch.json

# Derived dry-run output of tools/convert-ladder.mjs - regenerated on every run
tools/draft-levels.json
tools/draft-sentences.json

# S9 working data: excised-name spans of the corpus screen. Must never be committed
# (holds the raw hits). The 2026-08-20 near-staging is why this line exists.
tools/corpus/excisions.json
.stryker-tmp/

