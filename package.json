{
  "name": "word-quest",
  "version": "6.0.0",
  "description": "A phonics game with spaced repetition for early readers.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "pretest": "node tools/extract-engine.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutants": "node tools/extract-engine.mjs && node tools/mutants.mjs",
    "gen:acceptance": "node tools/gherkin-parse.mjs && node tools/gen-acceptance.mjs",
    "check:acceptance": "npm run gen:acceptance && git diff --exit-code -- tests/generated",
    "test:acceptance-mutants": "node tools/extract-engine.mjs && node tools/acceptance-mutants.mjs",
    "test:coverage": "node tools/extract-engine.mjs && vitest run --coverage",
    "lint:quality": "node tools/extract-engine.mjs && eslint . && node tools/dep-cycles.mjs && node tools/quality-control.mjs",
    "test:ui": "node tools/extract-engine.mjs && node tests/ui/interface.mjs",
    "test:a11y": "node tools/extract-engine.mjs && node tests/ui/a11y.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "playwright": "^1.62.0",
    "vitest": "^2.1.0"
  }
}
