{
  "name": "word-quest",
  "version": "6.0.0",
  "description": "A phonics game with spaced repetition for early readers.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "pretest": "node tools/extract-engine.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutants": "node tools/extract-engine.mjs && node tools/mutants.mjs",
    "gen:acceptance": "node tools/gherkin-parse.mjs && node tools/gen-acceptance.mjs",
    "check:acceptance": "npm run gen:acceptance && git diff --exit-code -- tests/generated",
    "test:acceptance-mutants": "node tools/extract-engine.mjs && node tools/acceptance-mutants.mjs"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "vitest": "^2.1.0"
  }
}
